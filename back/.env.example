PORT=3001
# Front-end URL(s) allowed to call the API, comma-separated. "*" matches one
# subdomain label, e.g. https://porfolio-*.vercel.app for Vercel preview deployments.
ALLOWED_ORIGINS=http://localhost:5173

# --- Chat model ---
# "groq" (hosted, answers in ~1s; required on small servers) or "ollama" (fully local).
# Defaults to groq when GROQ_API_KEY is set.
LLM_PROVIDER=groq
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# See the models your key can use: https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-20b
# For reasoning models (gpt-oss): low | medium | high. Empty = automatic (low for gpt-oss).
GROQ_REASONING_EFFORT=

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3
OLLAMA_KEEP_ALIVE=30m

# --- Retrieval ---
# Runs inside Node via Transformers.js (downloaded once, ~25 MB)
EMBED_MODEL=Xenova/all-MiniLM-L6-v2
# Relative to back/src
RESUME_PATH=../../front/src/assets/resume.pdf
TOP_K=5

# --- Contact form (POST /api/contact) ---
# Messages are emailed over SMTP. Leave SMTP_HOST empty to disable the form (it answers 503
# and the site shows a direct email link instead).
# Gmail: turn on 2-Step Verification, create an App password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASS (not your normal password).
SMTP_HOST=smtp.gmail.com
# 587 = STARTTLS, 465 = TLS from the start
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Inbox that receives the messages
CONTACT_TO=
# Sender address; defaults to SMTP_USER. Gmail only allows your own address or a verified alias.
CONTACT_FROM=
